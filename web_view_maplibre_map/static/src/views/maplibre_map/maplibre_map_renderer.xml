<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="web_view_maplibre_map.MapRenderer">
        <div class="o_maplibre_main_container h-100">
            <div t-ref="mapContainer" class="o_maplibre_map_container h-100" />
